# Build: docker build -f backend/Dockerfile.microservice --build-arg PROJECT_PATH=... --build-arg ASSEMBLY_NAME=... -t tms-service .
ARG PROJECT_PATH
ARG ASSEMBLY_NAME

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY backend/ backend/
RUN dotnet restore "${PROJECT_PATH}" \
    && dotnet publish "${PROJECT_PATH}" -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
ARG ASSEMBLY_NAME
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:8080
ENV DOTNET_RUNNING_IN_CONTAINER=true
EXPOSE 8080
USER $APP_UID
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1
ENTRYPOINT dotnet ${ASSEMBLY_NAME}.dll
