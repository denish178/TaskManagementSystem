# Copy this file to `.env` in the repo root (`.env` is gitignored).
# Required for local Docker SQL, backend scripts, and dev user seeding.

MSSQL_SA_PASSWORD=change-me-use-a-strong-local-password
JWT_SIGNING_KEY=change-me-use-at-least-32-characters-long
GEMINI_API_KEY=

# Dev seed users (Auth DevelopmentDataSeeder + scripts/e2e-gateway.ps1)
TMS_DEV_ADMIN_PASSWORD=change-me-admin-password
TMS_DEV_USER_PASSWORD=change-me-user-password
